rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profiles: Only owner can read, create, and update their profile document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasAll(['uid', 'email'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120;
      allow update: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid;
      allow delete: if false;

      // User assessments subcollection
      match /assessments/{assessmentId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(assessmentId)
          && request.resource.data.country is string
          && request.resource.data.country.size() <= 100
          && request.resource.data.score is number;
        allow update, delete: if isOwner(userId);
      }

      // User consultation bookings subcollection
      match /consultations/{consultationId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(consultationId)
          && request.resource.data.service is string
          && request.resource.data.branch is string;
        allow update, delete: if isOwner(userId);
      }

      // User uploaded documents subcollection
      match /documents/{documentId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && isValidId(documentId)
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 200;
        allow update, delete: if isOwner(userId);
      }

      // User chat sessions & messages
      match /chatSessions/{sessionId} {
        allow read, write: if isOwner(userId) && isValidId(sessionId);

        match /messages/{messageId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId)
            && isValidId(messageId)
            && request.resource.data.sender is string
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 5000;
          allow update, delete: if false;
        }
      }
    }

    // Public Branch Inquiries (Anyone can create with validation; no public read to protect contact PII)
    match /branchInquiries/{inquiryId} {
      allow create: if isValidId(inquiryId)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() <= 30;
      allow read, update, delete: if false;
    }

    // Public Appointment Slots (Anyone can view availability; authenticated users or bookings can reserve)
    match /appointmentSlots/{slotId} {
      allow read: if true;
      allow create, update: if isValidId(slotId)
        && request.resource.data.date is string
        && request.resource.data.timeSlot is string
        && request.resource.data.status in ['available', 'filling_fast', 'full'];
      allow delete: if false;
    }
  }
}
